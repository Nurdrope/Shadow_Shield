[Desktop Entry]
# Shadow_Shield tray dropdown. install.sh renders this into
# ~/.config/autostart/ (replacing __REPO_DIR__); use --no-tray to skip.
# Manual install:
#   mkdir -p ~/.config/autostart
#   sed "s|__REPO_DIR__|$HOME/Shadow_Shield|" gui/shadow-shield-tray.desktop \
#       > ~/.config/autostart/shadow-shield-tray.desktop
#
Type=Application
Name=Shadow_Shield Tray
Comment=Panel dropdown to toggle Shadow_Shield privacy/security features
Exec=python3 __REPO_DIR__/gui/shadow-shield-tray.py
Icon=security-high-symbolic
Terminal=false
Categories=System;Security;
X-GNOME-Autostart-enabled=true
